#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

echo "Updating refactored-64..."
git -C "$ROOT" pull --ff-only

echo "Starting GoldenEye-base merge path..."
echo "Legacy Mario/libsm64 sandbox is still available with: sh ./run-libsm64-prototype"

exec python3 "$ROOT/setup_goldeneye_base.py" --run "$@"
